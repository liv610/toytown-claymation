{
  "name": "toytown-web",
  "private": true,
  "description": "Toy Town browser prototypes (real-time Three.js and hybrid pre-rendered)",
  "devDependencies": {
    "@gltf-transform/cli": "4.1.1"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.1.1",
    "@gltf-transform/extensions": "^4.1.1",
    "@gltf-transform/functions": "^4.1.1",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.24.0",
    "meshoptimizer": "^0.22.0",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.8.3",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  },
  "scripts": {
    "dev": "python3 -m http.server 8765",
    "build:storybook": "npx esbuild storybook/src/main.js --bundle --format=esm --target=es2022 --outfile=storybook/dist/storybook.js",
    "build:handmade": "npx esbuild handmade/src/main.js --bundle --format=esm --target=es2022 --outfile=handmade/dist/handmade.js",
    "build": "npm run build:storybook",
    "package:journey": "bash ../tools/build_journey.sh ../dist/journey",
    "package:storybook": "bash ../tools/build_storybook.sh ../dist/storybook",
    "package:handmade": "bash ../tools/build_handmade.sh ../dist/handmade",
    "test:gift-direct": "mkdir -p ../dist/test && node ../tools/tests/journey_gift_direct.js ../dist/test",
    "test:storybook": "mkdir -p ../dist/test && node ../tools/tests/storybook_frames.js ../dist/test",
    "test:handmade": "mkdir -p ../dist/test && node ../tools/tests/handmade_interact.js ../dist/test"
  }
}
